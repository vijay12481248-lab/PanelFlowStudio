{
  "name": "panelflow-root",
  "version": "1.0.0-beta.2",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:desktop": "npm --workspace=@panelflow/desktop run dev",
    "build": "npm run build --workspaces",
    "engine": "python -m uvicorn engine.api.app:app --host 127.0.0.1 --port 8765 --reload",
    "test:engine": "pytest tests -v"
  }
}
