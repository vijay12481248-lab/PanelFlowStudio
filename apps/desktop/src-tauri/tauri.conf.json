{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PanelFlow Studio",
  "version": "1.0.0-2",
  "identifier": "com.panelflow.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PanelFlow Studio",
        "dragDropEnabled": false,
        "width": 1360,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "resources/engine_runtime/**/*",
      "../../../run_engine.py",
      "../../../engine/**/*"
    ]
  }
}
