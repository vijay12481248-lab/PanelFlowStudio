{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@panelflow/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@panelflow/api-client": ["../../packages/api-client/src/index.ts"],
      "@panelflow/ui": ["../../packages/ui/src/index.tsx"]
    }
  },
  "include": ["src"]
}
